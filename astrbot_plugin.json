{
    "name": "SaveBili",
    "version": "1.0.0",
    "author": "SATA‑F5",
    "description": "B站下载插件",
    "main": "main.py",
    "usage": """
     Savebili
     AstrBot 插件：下载 Bilibili 视频并发送到聊天窗口。
     功能
     通过指令或 @机器人 下载 B 站视频
     支持扫码登录 B 站获取高清画质
     支持手动添加 Cookie
     多 Cookie 管理，支持优先级、启用/禁用
     Web 管理页面，可管理账号和修改配置
    """
    "repo": "https://github.com/SATA‑F5/SaveBili",
    "dependencies": [
    "aiohttp",
    "quart",
    "qrcode[pil]",
    "Pillow"
]
}